# Local coursework values only. Copy to .env; do not commit .env.
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=local-coursework-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-coursework-change-me
# At least 32 characters; retain the same private key across Kibana restarts.
KIBANA_ENCRYPTION_KEY=local-coursework-encryption-key-change-me
APP_PORT=8000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=2
REQUEST_TIMEOUT_SECONDS=10
FAULT_DELAY_ENABLED=false
FAULT_DELAY_MS=500
FAULT_EVERY_N_REQUESTS=5
# Measured-machine label is explicit in observability/prometheus/prometheus.yml.
