{
  "uid": "campus-app",
  "title": "Campus | Application & business",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "campus",
    "assignment"
  ],
  "timezone": "utc",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "Requests per second",
      "type": "timeseries",
      "description": "Business traffic only; 1 minute rolling rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"campus-app\"}[1m]))",
          "legendFormat": "Requests per second",
          "refId": "A",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Successful requests per second",
      "type": "timeseries",
      "description": "HTTP 2xx.",
